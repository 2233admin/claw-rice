{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "claude-orange": "#D97757",
    "claude-dim": "#8B6B53",
    "text-muted": "#666666",
    "text-dim": "#444444",
    "text-faint": "#333333",
    "text-normal": "#999999",
    "path-color": "#888888",
    "git-clean": "#555555",
    "git-dirty": "#D97757",
    "error-red": "#CC5555",
    "success-dim": "#557755"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:path-color",
          "properties": {
            "folder_separator_icon": "/",
            "style": "full",
            "mapped_locations": {
              "D:/projects": "\uf07c projects"
            }
          },
          "style": "plain",
          "template": "{{ .Path }}",
          "type": "path"
        },
        {
          "foreground": "p:git-clean",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:git-dirty{{ end }}"
          ],
          "properties": {
            "branch_icon": "",
            "fetch_status": true
          },
          "style": "plain",
          "template": " {{ .HEAD }}{{ if .Working.Changed }} *{{ end }}{{ if .Staging.Changed }} +{{ end }}",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "p:text-dim",
          "style": "plain",
          "template": "{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}",
          "type": "python",
          "properties": {
            "display_virtual_env": true,
            "display_default": false,
            "display_version": true,
            "home_enabled": true,
            "display_mode": "context"
          }
        },
        {
          "foreground": "p:text-dim",
          "style": "plain",
          "template": " {{ .Full }}",
          "type": "node",
          "properties": {
            "display_mode": "context"
          }
        },
        {
          "foreground": "p:error-red",
          "style": "plain",
          "template": " {{ if gt .Code 0 }}{{ reason .Code }}{{ end }}",
          "type": "status"
        }
      ],
      "type": "rprompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:claude-orange",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error-red{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "\u276f ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "secondary_prompt": {
    "foreground": "p:text-faint",
    "template": "\u276f "
  },
  "transient_prompt": {
    "foreground": "p:claude-orange",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:error-red{{ end }}"
    ],
    "template": "\u276f "
  },
  "version": 4
}
